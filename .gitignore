# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# databases and data exploration
dev.db
dev.db-journal
bros-mapping-analysis.csv
*.csv

# SQLite export (có chứa toàn bộ data — không commit)
scripts/sqlite-export.json

# agent custom instructions
.claude/

# Ảnh upload cũ (không còn dùng — giờ dùng Google Drive link)
# Giữ lại để ignore nếu có file cũ còn sót
/public/labels/*
!/public/labels/.gitkeep
/public/products/**/*
!/public/products/.gitkeep
